# Neon Postgres — provisioned through the Vercel Marketplace.
# `vercel env pull` writes the real value into .env.local.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# NextAuth. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Who may sign in. Comma-separated; an empty list denies everyone.
# The first address is the identity the passcode grants.
ALLOWED_EMAILS=you@example.com

# Google OAuth. Leave blank until the client exists — the button stays hidden.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared passcode, so the board works before Google OAuth is configured.
APP_PASSCODE=

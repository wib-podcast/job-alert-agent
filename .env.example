# ── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres, shared with the web board. Get it with:  cd web && vercel env pull
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Neon's direct (non-pgbouncer) endpoint. Only needed to run the test suite
# locally — pooled connections reject the per-test schema isolation.
DATABASE_URL_UNPOOLED=

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com
ALERT_TO_EMAIL=you@example.com

# ── Enrichment ────────────────────────────────────────────────────────────────
CRUNCHBASE_API_KEY=

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=data/google_credentials.json

# ── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ── Job search preferences ────────────────────────────────────────────────────
# Comma-separated list of role keywords
TARGET_ROLES=Product Manager,AI Product Manager,Senior Product Manager
# Comma-separated list of location keywords
TARGET_LOCATIONS=Singapore,Dubai,London,Dublin,Remote
# Target geographies as ISO-3166 alpha-2, highest priority first. See SOURCES.md.
TARGET_GEOS=AE,SG,GB,IE,TH,MY,VN

# ── Scraper toggles ──────────────────────────────────────────────────────────
ENABLE_IIMJOBS=true
ENABLE_MYCAREERSFUTURE=true
ENABLE_LINKEDIN=false
ENABLE_GOOGLE_JOBS=false
# Jobs with relevance_score below this threshold are skipped in alerts
RELEVANCE_SCORE_THRESHOLD=7.0
